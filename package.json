{
  "name": "guestflow",
  "version": "2.1.0",
  "description": "Gestion d'accueils touristiques - Réservation et suivi financier",
  "private": true,
  "scripts": {
    "install:all": "cd server && npm install && cd ../client && npm install",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm start",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "stop": "node scripts/stop-dev.mjs",
    "build": "cd client && npm run build",
    "reset-admin": "cd server && npm run reset-admin",
    "test": "npm run test:server && npm run test:client",
    "test:server": "npm --prefix server test",
    "test:client": "npm --prefix client test",
    "test:e2e": "node e2e/wipe-db.js && playwright test",
    "test:e2e:headed": "node e2e/wipe-db.js && playwright test --headed",
    "test:e2e:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "better-sqlite3": "^13.0.3",
    "concurrently": "^10.0.4"
  }
}
