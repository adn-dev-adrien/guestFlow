{
  "name": "guestflow-control-plane-server",
  "version": "0.1.0",
  "private": true,
  "description": "GuestFlow control plane — the operator console (specs/control-plane-plans-and-access.md)",
  "scripts": {
    "start": "node src/index.js",
    "dev": "NODE_ENV=development node --watch src/index.js",
    "create-operator": "node scripts/create-operator.js",
    "test": "node --test --test-concurrency=1 --test-timeout=180000 --require ../../scripts/test-runner/test-exit-watchdog.cjs --test-reporter=spec --test-reporter-destination=stdout --test-reporter=../../scripts/test-runner/test-completeness-reporter.mjs --test-reporter-destination=stderr \"src/tests/**/*.test.js\""
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "better-sqlite3-session-store": "^0.1.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "nodemailer": "^10.0.10",
    "qrcode": "^1.5.4"
  }
}
