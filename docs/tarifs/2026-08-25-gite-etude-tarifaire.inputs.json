 "reglesCalendrier": {
  "spring": "Le mois d'avril",
  "shoulder": "Du 1er mai au 30 octobre",
  "july-shoulder": "La première semaine samedi-samedi de juillet",
  "august-shoulder": "La dernière semaine entière d'août",
  "summer-core": "Tout ce qui se trouve entre les deux épaules",
  "year-end": "Du 19 décembre au 1er janvier",
  "new-year": "Les nuits du 30 et du 31 décembre, découpées dans le bloc des fêtes",
  "ponts": "Chaque pont férié monte d'un cran et impose la durée de son bloc en minimum de séjour"
