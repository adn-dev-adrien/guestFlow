{
  "name": "guestflow-server",
  "version": "1.0.0",
  "scripts": {
    "dev:clean": "fuser -k 4000/tcp 2>/dev/null || true",
    "dev:watch": "nodemon --watch src --ext js,json --signal SIGTERM src/index.js",
    "dev": "npm run dev:clean && npm run dev:watch",
    "start": "node src/index.js",
    "reset-admin": "node scripts/reset-admin.js",
    "test": "node --test --test-concurrency=1 \"src/tests/**/*.test.js\""
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "better-sqlite3-session-store": "^0.1.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.19.0",
    "googleapis": "^174.0.0",
    "helmet": "^8.2.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.4",
    "pdfkit": "^0.18.0",
    "sharp": "^0.35.3",
    "web-push": "^3.6.7"
  }
}
