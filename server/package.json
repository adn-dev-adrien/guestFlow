{
  "name": "guestflow-server",
  "version": "4.7.0",
  "scripts": {
    "dev:clean": "fuser -k 4000/tcp 2>/dev/null || true",
    "dev:watch": "GUESTFLOW_PLUGINS=sources GUESTFLOW_DEV=1 nodemon --watch src --ext js,json --signal SIGTERM src/index.js",
    "dev": "npm run dev:clean && npm run dev:watch",
    "start": "node src/index.js",
    "reset-admin": "node scripts/reset-admin.js",
    "test": "node --test --test-concurrency=4 --test-timeout=60000 --require ./src/tests/setup/isolateDefaultDb.js --require ../scripts/test-runner/test-exit-watchdog.cjs --test-reporter=spec --test-reporter-destination=stdout --test-reporter=../scripts/test-runner/test-completeness-reporter.mjs --test-reporter-destination=stderr \"src/tests/**/*.test.js\" \"src/plugins/**/tests/*.test.js\""
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "better-sqlite3-session-store": "^0.1.0",
    "cors": "^2.8.5",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "express-session": "^1.19.0",
    "fflate": "0.8.3",
    "fontkit": "^3.0.0",
    "googleapis": "^190.0.0",
    "helmet": "^8.3.0",
    "imapflow": "^2.12.1",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.0",
    "pdfkit": "^0.21.0",
    "qrcode": "^1.5.4",
    "semver": "^7.8.6",
    "sharp": "^0.35.5",
    "undici": "8.12.4",
    "web-push": "^4.0.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true
  }
}
