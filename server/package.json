{
  "name": "guestflow-server",
  "version": "3.18.0",
  "scripts": {
    "dev:clean": "fuser -k 4000/tcp 2>/dev/null || true",
    "dev:watch": "GUESTFLOW_PLUGINS=sources GUESTFLOW_DEV=1 nodemon --watch src --ext js,json --signal SIGTERM src/index.js",
    "dev": "npm run dev:clean && npm run dev:watch",
    "start": "node src/index.js",
    "reset-admin": "node scripts/reset-admin.js",
    "test": "node --test --test-concurrency=1 --test-timeout=60000 --test-force-exit --require ./src/tests/setup/isolateDefaultDb.js \"src/tests/**/*.test.js\" \"src/plugins/**/tests/*.test.js\""
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "better-sqlite3-session-store": "^0.1.0",
    "cors": "^2.8.5",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "fontkit": "^2.0.4",
    "googleapis": "^188.0.0",
    "helmet": "^8.3.0",
    "imapflow": "^2.9.1",
    "multer": "^2.5.0",
    "nodemailer": "^10.2.1",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "semver": "^7.8.5",
    "sharp": "^0.35.5",
    "undici": "7.30.1",
    "web-push": "^3.6.7"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true
  }
}
