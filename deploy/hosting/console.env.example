# /srv/guestflow/console/env — the console's environment (mode 600, owner guestflow).
# bootstrap-host.sh writes this file from the example; fill in every « à remplir ».
# Anything but `development` or `test` runs as production: CP_SESSION_SECRET and CP_PROXY_SECRET are
# then required, or the console refuses to start (control-plane rule 39). Keep `production` here.
NODE_ENV=production
CP_PORT=4100
CP_DATA_DIR=/srv/guestflow/console/data
CP_INSTANCES_ROOT=/srv/guestflow/instances
CP_RELEASES_DIR=/srv/guestflow/releases
CP_DOMAIN=__DOMAIN__
CP_PUBLIC_URL=https://console.__DOMAIN__
CP_APP_HOST=app.__DOMAIN__
CP_SESSION_SECRET=__SESSION_SECRET__
# Ed25519 private key, base64 DER PKCS8 (control-plane rule 30) — generated by bootstrap-host.sh
# when empty (H1 rule 26). Keep a copy offline.
CP_LICENCE_PRIVATE_KEY=
# Optional separate Ed25519 key (same format) signing the plugin registry's index. Empty: the licence key
# signs it (historical). Set it so a leak of one key does not forge the other.
CP_REGISTRY_PRIVATE_KEY=
# The console's own email (operator codes, alerts) — à remplir.
CP_SMTP_HOST=
CP_SMTP_PORT=587
CP_SMTP_USER=
CP_SMTP_PASS=
CP_SMTP_FROM="Console GuestFlow <console@__DOMAIN__>"

# Hosting drivers (specs/hosting-h1-fleet-runtime.md H-D6).
CP_PROCESS_DRIVER=systemd
CP_PROXY_DRIVER=caddy
CP_BACKUP_DRIVER=litestream
CP_MAIL_DRIVER=platform
CP_PORT_RANGE=4400-4499
CP_SYSTEMCTL="sudo -n /usr/local/sbin/guestflow-systemctl"
CP_LITESTREAM_APPLY="sudo -n /usr/local/sbin/guestflow-litestream-apply"
CP_IDENTITY_COMMAND="sudo -n /usr/local/sbin/guestflow-instance-identity"
CP_ENVS_DIR=/srv/guestflow/envs
# The header Caddy adds to what it forwards to the console (rule 21) — written by bootstrap. Required:
# without it the console does not start (control-plane rule 39).
CP_PROXY_SECRET=__PROXY_SECRET__
CP_CADDY_SITES_DIR=/etc/caddy/sites
CP_CADDYFILE=/etc/caddy/Caddyfile
CP_CLOSED_PAGE_DIR=/srv/guestflow/closed
# Object storage (EU). The single source of the backup target and its keys (H1 rule 27): the console
# passes the target to guestflow-litestream-apply, which writes /etc/litestream.yml; bootstrap copies
# the keys to /etc/default/litestream; rclone gets them from the console, its remote derived from
# CP_BACKUP_URL. bootstrap-host.sh fills the keys from S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY.
CP_BACKUP_URL=s3://guestflow-backups/fleet
CP_BACKUP_ENDPOINT=https://s3.fr-par.scw.cloud
CP_BACKUP_REGION=fr-par
# CP_RCLONE_REMOTE=<remote>:<bucket>/<path> only for a remote configured by hand with `rclone config`.
# The console lists and restores the replicas itself (rules 13–15), with these keys passed to
# Litestream through its environment, never into a file.
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
# The platform sender (rule 18) — à remplir.
CP_PLATFORM_SMTP_HOST=
CP_PLATFORM_SMTP_PORT=587
CP_PLATFORM_SMTP_USER=
CP_PLATFORM_SMTP_PASS=
CP_PLATFORM_MAIL_FROM=noreply@__DOMAIN__
CP_MAIL_DAILY_LIMIT=300
