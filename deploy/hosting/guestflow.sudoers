# GuestFlow host (specs/hosting-h1-fleet-runtime.md H-D1, H-D3): the console, running as
# `guestflow`, may run three root commands — the instance units, each instance's user and unit
# drop-in, and Litestream's configuration from checked entries (rule 21).
# Installed by bootstrap-host.sh into /etc/sudoers.d/guestflow (mode 440).
guestflow ALL=(root) NOPASSWD: /usr/local/sbin/guestflow-systemctl, /usr/local/sbin/guestflow-litestream-apply, /usr/local/sbin/guestflow-instance-identity
