#!/usr/bin/env bash
# The only root command the console may run (specs/hosting-h1-fleet-runtime.md H-D1, H-D3).
# Installed by bootstrap-host.sh as /usr/local/sbin/guestflow-systemctl (root:root, 755) and allowed
# by /etc/sudoers.d/guestflow. It accepts exactly the systemctl calls the drivers make — on one
# `guestflow@<slug>.service` at a time, or the Litestream restart — and refuses anything else.
set -euo pipefail

unit='^guestflow@[a-z0-9-]{3,30}\.service$'
case "${1:-} ${2:-}" in
  "enable --now"|"disable --now")
    [[ $# -eq 3 && "$3" =~ $unit ]] || { echo "refusé : $*" >&2; exit 64; }
    exec /usr/bin/systemctl "$1" "$2" "$3" ;;
esac
case "${1:-}" in
  start|stop|restart|reset-failed)
    if [[ $# -eq 2 && "$2" =~ $unit ]]; then exec /usr/bin/systemctl "$1" "$2"; fi
    if [[ $# -eq 2 && "$1" == "restart" && "$2" == "litestream" ]]; then exec /usr/bin/systemctl restart litestream; fi ;;
esac
echo "refusé : $*" >&2
exit 64
